# Required for real verdicts. Without it, run `npm run dev:mock`.
ANTHROPIC_API_KEY=

# Public address of the site, used in share links and on the card.
PUBLIC_URL=https://example.com

# Optional
PORT=3000
BOARDROOM_MODEL=claude-opus-5-5
BOARDROOM_PER_IP_LIMIT=5
BOARDROOM_WINDOW_MINUTES=10
BOARDROOM_DAILY_CAP=500
BOARDROOM_DATA_DIR=./data
# Set to 1 only when running behind a reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=0

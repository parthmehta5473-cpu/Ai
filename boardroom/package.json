{
  "name": "ai-boardroom",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pitch a startup idea in one sentence; four AI executives argue about it and issue a shareable verdict.",
  "engines": { "node": ">=22.18" },
  "scripts": {
    "start": "node src/server.ts",
    "dev": "node --watch src/server.ts",
    "dev:mock": "BOARDROOM_MOCK=1 node --watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "BOARDROOM_MOCK=1 BOARDROOM_MOCK_DELAY_MS=5 node --test test/*.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@resvg/resvg-js": "^2.6.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0"
  }
}
